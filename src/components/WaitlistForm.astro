---
// Waitlist signup. POSTs JSON { form: 'beta', email } to PUBLIC_FORM_ENDPOINT (the Formspree
// form shared with the contact form). While that is unset the form only shows the thank-you and
// stores nothing. On success, ticker tape bursts out from behind the form and the thank-you pops
// up in a speech bubble under it.
---

<div class="wl">
  <!-- the ticker tape is drawn here, behind the form, and spills well past it -->
  <canvas class="wl-burst" id="wl-burst" aria-hidden="true"></canvas>
  <form class="mk-form" id="mk-form" novalidate data-endpoint={import.meta.env.PUBLIC_FORM_ENDPOINT ?? ''}>
    <label for="mk-email" class="mk-sr">Work email</label>
    <input id="mk-email" name="email" type="email" autocomplete="email" placeholder="Work email" required />
    <button class="mk-btn" type="submit">Join the beta</button>
  </form>
</div>
<p class="mk-note" id="mk-note" aria-live="polite">Early access for a small group of teams.</p>

<style>
  .wl{position:relative;isolation:isolate;max-width:500px}  /* isolate: the canvas sits behind the form, above the page */
  .wl-burst{position:absolute;z-index:-1;pointer-events:none;left:-240px;top:-280px;width:calc(100% + 480px);height:calc(100% + 560px)}
  .mk-form{display:flex;align-items:center;gap:8px;max-width:500px;background:var(--mk-field);border:1px solid var(--mk-line);border-radius:999px;padding:6px;transition:border-color .2s}
  .mk-form:focus-within{border-color:#55555C}
  input{flex:1;min-width:0;height:52px;background:transparent;border:0;outline:0;border-radius:999px;  /* round, so an autofill fill matches the pill */
    font:400 17px var(--mk-font);color:var(--mk-text);padding:0 12px 0 14px}
  input::placeholder{color:var(--mk-muted)}
  button{flex:none}
  .mk-note{font:400 13px var(--mk-font);color:var(--mk-muted);margin:14px 0 0}
  .mk-note.ok{color:var(--mk-text)}
  .mk-note.err{color:#F08A70}

  /* Thank-you speech bubble: cream, its tail pointing up at the form. Built by the script, hence :global */
  .mk-note :global(.wl-bubble){position:relative;display:inline-block;margin-top:4px;padding:14px 20px 15px;border-radius:20px;
    background:var(--mk-text);color:var(--mk-bg);transform-origin:30px -8px;animation:wl-pop .55s cubic-bezier(.2,1.5,.4,1) both}
  .mk-note :global(.wl-bubble)::before{content:"";position:absolute;left:22px;top:-7px;width:16px;height:16px;border-radius:3px;
    background:inherit;transform:rotate(45deg)}
  .mk-note :global(.wl-bubble b){display:block;font:400 24px/1 var(--mk-display);letter-spacing:0}
  .mk-note :global(.wl-bubble span){display:block;margin-top:6px;font:400 15px/1.4 var(--mk-font);color:#46464C}
  @keyframes wl-pop{from{opacity:0;transform:scale(.5) rotate(-4deg)}to{opacity:1;transform:none}}
  @media (prefers-reduced-motion: reduce){ .mk-note :global(.wl-bubble){animation:none} }

  @media (max-width: 480px){
    .mk-form{flex-direction:column;align-items:stretch;padding:8px;border-radius:30px}  /* stacked: pill ends would be too big */
    input{flex:none;width:100%;padding:0 10px}
    button{width:100%}
  }
</style>

<script>
  const form = document.getElementById('mk-form') as HTMLFormElement;
  const input = document.getElementById('mk-email') as HTMLInputElement;
  const button = form.querySelector('button') as HTMLButtonElement;
  const note = document.getElementById('mk-note') as HTMLParagraphElement;
  const canvas = document.getElementById('wl-burst') as HTMLCanvasElement;
  const endpoint = form.dataset.endpoint;
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  const defaultNote = note.textContent ?? '';
  const showError = (text: string) => {
    note.className = 'mk-note err';
    note.textContent = text;
  };
  const showThanks = () => {
    const bubble = document.createElement('span');
    bubble.className = 'wl-bubble';
    const title = document.createElement('b');
    title.textContent = 'You’re on the list!';
    const line = document.createElement('span');
    line.textContent = 'Thanks for signing up. We’ll be in touch soon.';
    bubble.append(title, line);
    note.className = 'mk-note ok';
    note.replaceChildren(bubble);
  };

  // Ticker tape: strips and a few dots in the brand golds, cream and coral, fired from behind the
  // form in a fan that's mostly upwards, then fluttering down under gravity and fading out.
  const COLOURS = ['#FFE680', '#F6C443', '#F09C3C', '#EDEBE6', '#F2603F', '#FFFFFF'];
  const burst = () => {
    if (reduced) return;
    const ctx = canvas.getContext('2d');
    if (!ctx) return;
    const dpr = Math.min(window.devicePixelRatio || 1, 2);
    const box = canvas.getBoundingClientRect();
    canvas.width = Math.round(box.width * dpr);
    canvas.height = Math.round(box.height * dpr);
    ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    const f = form.getBoundingClientRect();
    const fx = f.left - box.left, fy = f.top - box.top, cx = fx + f.width / 2;

    const bits = Array.from({ length: 150 }, () => {
      const x = fx + 16 + Math.random() * (f.width - 32);
      const spread = (x - cx) / (f.width / 2);            // -1 at the left end, 1 at the right
      const angle = -Math.PI / 2 + spread * 1.15 + (Math.random() - 0.5) * 0.7;
      const speed = 420 + Math.random() * 520;            // px per second
      const strip = Math.random() < 0.7;
      return {
        x, y: fy + f.height * (0.3 + Math.random() * 0.4),
        vx: Math.cos(angle) * speed, vy: Math.sin(angle) * speed,
        w: strip ? 5 + Math.random() * 3 : 6 + Math.random() * 3,
        h: strip ? 12 + Math.random() * 8 : 0,             // h 0: a dot
        rot: Math.random() * Math.PI, spin: (Math.random() - 0.5) * 12,
        flip: Math.random() * Math.PI, flipRate: 6 + Math.random() * 8,
        colour: COLOURS[(Math.random() * COLOURS.length) | 0],
        life: 1.9 + Math.random() * 1.1,                   // seconds before it has faded out
      };
    });

    let last = performance.now(), age = 0;
    const frame = (now: number) => {
      const dt = Math.min(0.05, (now - last) / 1000);
      last = now; age += dt;
      ctx.clearRect(0, 0, box.width, box.height);
      let alive = 0;
      for (const b of bits) {
        if (age > b.life) continue;
        alive++;
        const drag = Math.pow(0.18, dt);                   // air resistance: tape slows fast, then floats
        b.vx *= drag; b.vy = b.vy * drag + 900 * dt;       // gravity
        b.x += b.vx * dt + Math.sin(b.flip) * 18 * dt;      // a little sideways flutter
        b.y += b.vy * dt;
        b.rot += b.spin * dt; b.flip += b.flipRate * dt;
        ctx.globalAlpha = Math.min(1, (b.life - age) / 0.5);
        ctx.fillStyle = b.colour;
        ctx.save();
        ctx.translate(b.x, b.y);
        ctx.rotate(b.rot);
        if (b.h) {
          ctx.scale(1, Math.cos(b.flip));                  // the strip turning over as it falls
          ctx.fillRect(-b.w / 2, -b.h / 2, b.w, b.h);
        } else {
          ctx.beginPath(); ctx.arc(0, 0, b.w / 2, 0, Math.PI * 2); ctx.fill();
        }
        ctx.restore();
      }
      if (alive) requestAnimationFrame(frame);
      else ctx.clearRect(0, 0, box.width, box.height);
    };
    requestAnimationFrame(frame);
  };

  // clear an error as soon as the email is edited
  input.addEventListener('input', () => {
    if (note.classList.contains('err')) {
      note.className = 'mk-note';
      note.textContent = defaultNote;
    }
  });

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    const email = input.value.trim();
    if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
      showError('Please enter a valid email address.');
      input.focus();
      return;
    }
    const done = () => { burst(); showThanks(); form.reset(); };
    if (!endpoint) { done(); return; }
    button.disabled = true;
    try {
      const r = await fetch(endpoint, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
        // _subject sets the notification email's subject line in Formspree
        body: JSON.stringify({ form: 'beta', email, _subject: 'New Marketann beta signup' }),
      });
      if (!r.ok) throw new Error(String(r.status));
      done();
    } catch {
      showError('Something went wrong. Please email info@marketann.ai instead.');
    } finally {
      button.disabled = false;
    }
  });
</script>
