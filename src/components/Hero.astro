---
import WaitlistForm from './WaitlistForm.astro';
import BrandEngine from './BrandEngine/BrandEngine.astro';
---

<main id="top" class="mk-wrap mk-hero">
  <div class="mk-copy">
    <h1 class="mk-h1">Create with AI that <span class="mk-h1b">knows your <span class="nowrap">brand</span></span></h1>
    <p class="mk-sub">AI makes every company look the same. Turn your brand into a system that produces on-brand marketing and design work, right first time, and distinct from everyone else.</p>
    <WaitlistForm />
  </div>

  <div class="mk-anim">
    <BrandEngine />
  </div>
</main>

<style>
  .mk-hero{display:grid;grid-template-columns:minmax(0,1.05fr) minmax(0,1fr);gap:64px;align-items:center;min-height:calc(100vh - 84px);padding-top:16px;padding-bottom:72px}
  .mk-copy{max-width:580px;position:relative;z-index:1}  /* keeps the copy above the grid */
  .mk-h1{font:400 clamp(38px,4.3vw,60px)/.94 var(--mk-display);letter-spacing:0;margin:0 0 28px;color:#76767E;text-wrap:balance}  /* balance: breaks before "knows your brand" at any width */
  .mk-h1b{color:var(--mk-text)}
  .nowrap{white-space:nowrap}
  .mk-sub{font:400 clamp(17px,1.3vw,19px)/1.5 var(--mk-font);color:var(--mk-body);margin:0 0 40px;max-width:480px}
  .mk-anim{justify-self:end;width:100%;max-width:580px;position:relative;isolation:isolate;margin-right:-24px}  /* nudged into the page margin, away from the copy */
  /* Faint squared-paper grid behind the animation, spilling past its edges and fading out.
     Weighted to the right (80% vs 40%) so it fades out before it reaches the headline and copy. */
  .mk-anim::before{content:"";position:absolute;inset:-35% -80% -35% -40%;z-index:-1;pointer-events:none;
    --grid-line:rgba(237,235,230,.11);
    background-image:linear-gradient(var(--grid-line) 1px,transparent 1px),linear-gradient(90deg,var(--grid-line) 1px,transparent 1px);
    background-size:64px 64px;background-position:center center;
    -webkit-mask-image:radial-gradient(closest-side,#000 8%,rgba(0,0,0,.75) 35%,rgba(0,0,0,.4) 60%,rgba(0,0,0,.12) 82%,transparent);
    mask-image:radial-gradient(closest-side,#000 8%,rgba(0,0,0,.75) 35%,rgba(0,0,0,.4) 60%,rgba(0,0,0,.12) 82%,transparent)}

  @media (max-width: 900px){
    .mk-hero{grid-template-columns:1fr;gap:48px;min-height:0;padding-top:64px;padding-bottom:56px}
    .mk-anim{justify-self:center;margin-right:0}
    .mk-h1{font-size:clamp(38px,6.2vw,52px)}  /* grows on tablets */
  }
  /* phones: the animation runs edge to edge */
  /* small phones: size the headline to the screen so it always sets as two lines */
  @media (max-width: 480px){
    .mk-h1{font-size:max(28px,9.9vw)}
  }
  @media (max-width: 520px){
    .mk-anim{margin:0 -16px;width:calc(100% + 32px);max-width:none}
  }
</style>
