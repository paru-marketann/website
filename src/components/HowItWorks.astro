---
const steps = [
  {
    title: 'We build your brand engine',
    body: 'We turn your brand rules (colours, type, layout, tone of voice and messaging) into an engine that is clearly defined and knows them inside out.',
  },
  {
    title: 'Create work that’s yours',
    body: 'Generate marketing and design collateral that isn’t AI slop. Every piece is on-brand, right first time, and distinct from everyone else.',
  },
  {
    title: 'Change it once, everywhere',
    body: 'When your brand changes, update it in one place. Everything you make from then on changes with it.',
  },
];

const outputs = [
  'Websites and landing pages',
  'Pitch decks',
  'Social posts',
  'Paid social ads',
  'Email campaigns',
  'Annual reports',
  'One-pagers and sales sheets',
  'Business cards and letterheads',
  'Event signage',
  'Merch',
  'Explainer videos',
];
---

<section class="mk-section" id="how-it-works" aria-labelledby="how-title">
  <div class="mk-wrap">
    <h2 class="mk-h2" id="how-title">How it works</h2>
    <p class="mk-lead">Most AI tools know nothing about your brand, so everything they make looks like everyone else’s. Marketann starts from your brand rules and builds everything from there.</p>

    <ol class="steps">
      {steps.map((step, i) => (
        <li class="step">
          <span class="num">{String(i + 1).padStart(2, '0')}</span>
          <h3>{step.title}</h3>
          <p>{step.body}</p>
        </li>
      ))}
    </ol>

    <div class="create">
      <h3>What you can create</h3>
      <ul>
        {outputs.map((o) => <li>{o}</li>)}
      </ul>
    </div>
  </div>
</section>

<style>
  .steps{list-style:none;margin:64px 0 0;padding:0;display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:20px}
  .step{background:var(--mk-field);border:1px solid var(--mk-line);border-radius:24px;corner-shape:squircle;padding:32px 28px 36px}
  .num{display:inline-block;font:600 15px/1 var(--mk-font);letter-spacing:.04em;margin-bottom:40px;
    background:var(--mk-grad);-webkit-background-clip:text;background-clip:text;color:transparent}
  .step h3{font:600 22px/1.2 var(--mk-font);letter-spacing:-.015em;margin:0 0 12px;color:var(--mk-text)}
  .step p{font:400 16px/1.55 var(--mk-font);color:var(--mk-body);margin:0}

  .create{margin-top:80px}
  .create h3{font:600 22px/1.2 var(--mk-font);letter-spacing:-.015em;margin:0 0 24px;color:var(--mk-text)}
  .create ul{list-style:none;margin:0;padding:0;display:flex;flex-wrap:wrap;gap:10px}
  .create li{font:400 16px/1 var(--mk-font);color:var(--mk-text);padding:12px 18px;border:1px solid var(--mk-line);border-radius:999px;corner-shape:squircle}

  @media (max-width: 900px){
    .steps{grid-template-columns:1fr;margin-top:40px}
    .num{margin-bottom:24px}
    .create{margin-top:56px}
  }
</style>
