---
import Logo from './Logo.astro';
---

<header class="mk-head">
  <a class="mk-logo" href="#top" aria-label="Marketann"><Logo /></a>
  <nav class="mk-nav" aria-label="Main">
    <a class="mk-link" href="#how-it-works">How it works</a>
    <a class="mk-link" href="#why-us">Why us</a>
    <a class="mk-contact" href="#contact">Contact</a>
  </nav>
</header>

<style>
  .mk-head{display:flex;align-items:center;justify-content:space-between;height:84px;padding:0 28px}
  .mk-logo :global(svg){height:20px}
  .mk-nav{display:flex;align-items:center;gap:32px}
  .mk-link{font:500 15px var(--mk-font);text-decoration:none;color:var(--mk-body);transition:color .2s}
  .mk-link:hover{color:var(--mk-text)}
  .mk-contact{font:700 13px var(--mk-font);text-transform:uppercase;letter-spacing:.04em;text-decoration:none;color:var(--mk-bg);background:#fff;padding:10px 18px;border-radius:20px;corner-shape:squircle;transition:background .2s}
  .mk-contact:hover{background:var(--mk-text)}

  @media (max-width: 900px){
    .mk-head{height:68px;padding:0 16px}
    .mk-nav{gap:20px}
    .mk-link{font-size:14px}
    .mk-contact{font-size:12px;padding:9px 14px}
    .mk-logo :global(svg){height:17px}
  }
  /* no room for the text links on small phones; the sections are a scroll away */
  @media (max-width: 520px){
    .mk-link{display:none}
  }
</style>
