---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Marketann',
  description = 'AI makes every company look the same. Turn your brand into a system that produces on-brand marketing and design work, right first time, and distinct from everyone else.',
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0B0B0C" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <!-- Figtree: stand-in until the Apercu web licence files are added (see styles/global.css).
         Tilt Warp + Besley: Fieldwork, the example brand in the animations. -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Figtree:wght@400;500;600;700&family=Besley:wght@400;500;600;700&family=Tilt+Warp&display=swap" rel="stylesheet" />
  </head>
  <body>
    <div class="mk-page"><slot /></div>
  </body>
</html>
